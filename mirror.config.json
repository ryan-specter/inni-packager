{
  "source_repo": "y1-community/y1-stock-rom",
  "mirror_repo": "",
  "branch": "main",
  "updater_repo": "y1-community/updater-ce-neo",
  "title_prefix": "Portable Flashing Package: ",
  "copy_original_assets": true,
  "source_readme": {
    "enabled": true,
    "path": "README.md",
    "commit_message": "Mirror source README"
  },
  "build_workers": 2,
  "max_asset_bytes": 2147483648,
  "firmware": {
    "include": [
      "*.zip"
    ],
    "exclude": [
      "*-windows.zip",
      "*-windows-arm64.zip",
      "*-windows-legacy.zip",
      "*-linux.zip",
      "*-linux-arm64.zip",
      "*-linux-legacy.zip",
      "*-macos.zip",            "*portable*.zip",
            "*source*.zip",
            "*installer*.zip",
      "*.dmg",
      "*.apk",
      "*.tar.gz",
      "*.tgz",
      "*.tar",
      "*.sha256",
      "*.json",
      "*.txt",
      "*.sig",
      "*.img.gz",
      "*.exe",
      "*.appimage"
    ],
    "require_scatter": true
  },
  "releases": {
    "include_prereleases": true,
    "tags": [],
    "exclude_tags": []
  },
  "defaults": {
    "software_name": "Original Software",
    "target_model": "Y1",
    "target_type": "Type A",
    "description": ""
  },
  "rules": [
    {
      "match_asset": "(?i)(^|[-_.])y2([-_.]|$)",
      "target_model": "Y2",
      "target_type": "Stock"
    },
    {
      "match_asset": "(?i)type[-_ ]?b",
      "target_model": "Y1",
      "target_type": "Type B"
    }
  ],
  "platforms": {
    "windows": {
      "updater_asset": "UpdaterCE-Windows-Portable.zip",
      "suffix": "-windows.zip",
      "layout": "sp_flash_tool",
      "os": "windows",
      "arch": "x86-64"
    },
    "windows-arm64": {
      "updater_asset": "UpdaterCE-Windows-Portable-arm64.zip",
      "suffix": "-windows-arm64.zip",
      "layout": "sp_flash_tool",
      "os": "windows",
      "arch": "arm64",
      "optional": true
    },
    "windows-legacy": {
      "updater_asset": "flash_tool_windows.zip",
      "updater_asset_alternates": [
        "SP_Flash_Tool-Windows.zip",
        "Innioasis-SP-Flash-Tool-windows-legacy.zip"
      ],
      "driver_asset": "1.Install.Driver.First.and.Reboot.PC.exe",
      "updater_repo": "y1-community/innioasis-updater",
      "suffix": "-windows-legacy.zip",
      "layout": "sp_flash_tool",
      "os": "windows",
      "arch": "x86",
      "optional": true,
      "legacy": true
    },
    "linux": {
      "updater_asset": "UpdaterCE-Linux-Portable.zip",
      "suffix": "-linux.zip",
      "layout": "sp_flash_tool",
      "os": "linux",
      "arch": "x86-64"
    },
    "linux-arm64": {
      "updater_asset": "UpdaterCE-Linux-Portable-arm64.zip",
      "suffix": "-linux-arm64.zip",
      "layout": "sp_flash_tool",
      "os": "linux",
      "arch": "arm64",
      "optional": true
    },
    "linux-legacy": {
      "updater_asset": "flash_tool_linux.zip",
      "updater_asset_alternates": ["SP_Flash_Tool-Linux.zip"],
      "updater_repo": "y1-community/innioasis-updater",
      "suffix": "-linux-legacy.zip",
      "layout": "sp_flash_tool",
      "os": "linux",
      "arch": "x86",
      "optional": true,
      "legacy": true
    },
    "macos": {
      "updater_asset": "Innioasis.Updater.for.Mac.dmg",
      "suffix": "-macos.zip",
      "layout": "beside_dmg",
      "os": "macos",
      "arch": "universal",
      "updater_repo": "y1-community/innioasis-updater"
    }
  }
}
